# SimpleMMO — public example env. Copy to .env.local and fill in values.
# NEVER commit real secrets. Production uses GitHub Secrets / Vercel Env Vars.

# Supabase (public, safe for client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase (server-only — Edge Functions / Server Actions only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase CLI (local deploys only, never commit)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_OFFLINE_CAP_HOURS=12
NEXT_PUBLIC_OFFLINE_EFFICIENCY=0.6

# Vercel (CI/CD only via GitHub Secrets)
# VERCEL_TOKEN / VERCEL_ORG_ID / VERCEL_PROJECT_ID
